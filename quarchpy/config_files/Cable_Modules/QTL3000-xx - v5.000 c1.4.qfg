@CONFIG Version=1

# Torridon RJ-45 Cable Module + Triggering
@HEADER
DeviceClass=TorridonModule
DeviceNumbers=QTL3000-xx
DeviceNumbersExclude=
MinFirmwareRequired=5.000
MinFpgaRequired=1.4
DeviceDescription=RJ-45 Cable Pull Module Triggering

#Describes general module abilities
@GENERAL
HotPlugRead_Present = true
GlitchStateRead_Present = true
SourceUserBounce_Present = true
SignalDrive_Present=false
HighResTiming_Present=true
BounceV2_Present=true
Triggering_Present=true
SignalMonitor_Present=false

#Describes all signals on the module
@SIGNALS
Name=A_PL,GlitchEnable_Present=true,DefaultSource=1
Name=A_MN,GlitchEnable_Present=true,DefaultSource=1
Name=B_PL,GlitchEnable_Present=true,DefaultSource=1
Name=B_MN,GlitchEnable_Present=true,DefaultSource=1
Name=C_PL,GlitchEnable_Present=true,DefaultSource=1
Name=C_MN,GlitchEnable_Present=true,DefaultSource=1
Name=D_PL,GlitchEnable_Present=true,DefaultSource=1
Name=D_MN,GlitchEnable_Present=true,DefaultSource=1

@SIGNAL_GROUPS
Name=ALL,Signals="A_PL,A_MN,B_PL,B_MN,C_PL,C_MN,D_PL,D_MN"
Name=PAIR_A,Signals="A_PL,A_MN"
Name=PAIR_B,Signals="B_PL,B_MN"
Name=PAIR_C,Signals="C_PL,C_MN"
Name=PAIR_D,Signals="D_PL,D_MN"

# Describes all sources on the module
@SOURCES

# Describes basic source parameters
@SOURCE_START
Number=0
Type=ALWAYS_OFF
Name=Source 0
SourceEnable_Present=false
@SOURCE_END


# Describes basic source parameters
@SOURCE_START
Number=1
Type=TIMED
Name=Source 1
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=2
Type=TIMED
Name=Source 2
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=3
Type=TIMED
Name=Source 3
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=4
Type=TIMED
Name=Source 4
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=5
Type=TIMED
Name=Source 5
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=6
Type=TIMED
Name=Source 6
SourceDelay_Limits=ms,0,127,1
SourceDelay_Limits=ms,0,1270,10
SourceEnable_Present=true

# Describes source pin-bounce parameters
@SOURCE_BOUNCE
SourceBounce_Present=true
BounceLength_Limits=ms,0,127,1
BounceLength_Limits=ms,0,1270,10
BouncePeriod_Limits=us,10,1270,10
BouncePeriod_Limits=us,1000,127000,1000
BounceDuty_Limits=int,1,100,1
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=7
Type=IMMEDIATE_CHANGE
Name=Source 7
SourceEnable_Present=false
@SOURCE_END

# Describes basic source parameters
@SOURCE_START
Number=8
Type=ALWAYS_ON
Name=Source 8
SourceEnable_Present=false
@SOURCE_END

# Describes glitching module
@GLITCH
GlitchSignals_present=true
GlitchSignals_Version=2
GlitchLength_Limits=int,0,255,1
GlitchMultiplier_Settings=50ns,500ns,5us,50us,500us,5ms,50ms,500ms
GlitchPrbs_Settings=1:2,1:4,1:8,1:16,1:32,1:64,1:128,1:256,1:512,1:1024,1:2048,1:4096,1:8192,1:16384,1:32768,1:65536

@MEASURE
Name=1v2,Type=SelfVoltage,NominalValue=1200
Name=3v3,Type=SelfVoltage,NominalValue=3300
Name=12v,Type=SelfVoltage,NominalValue=12000