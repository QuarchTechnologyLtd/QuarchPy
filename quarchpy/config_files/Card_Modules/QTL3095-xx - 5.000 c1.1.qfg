@CONFIG Version=1

# OCP NIC Card Module
@HEADER
DeviceClass=TorridonModule
DeviceNumbers=QTL3095-xx
DeviceNumbersExclude=
MinFirmwareRequired=5.000
MinFpgaRequired=1.1
DeviceDescription=Gen5 OCP NIC x16 Breaker

#Describes general module abilities
@GENERAL
HotPlugRead_Present = true
GlitchStateRead_Present = true
SourceUserBounce_Present = true
HighResTiming_Present=true
BounceV2_Present=true
SignalDrive_Present=true
SignalMonitor_Present=true
Triggering_Present=false
HostPowerTriggering_Present=3V3_AUX_HOST,12V_HOST
LaneWidth_Present=16
# PCIe signals are not in order, this flag warns the CLI test that it needs to be more clever about testing them
OutOfOrderSignalsInLanes_Present=false

