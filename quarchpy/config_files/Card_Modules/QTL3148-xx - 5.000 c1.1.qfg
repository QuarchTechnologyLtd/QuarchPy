Name=PRESENT2_B48,GlitchEnable_Present=true,DefaultSource=1
Name=PRESENT2_B81,GlitchEnable_Present=true,DefaultSource=1
Name=TRST,GlitchEnable_Present=true,DefaultSource=1
Name=TCK,GlitchEnable_Present=true,DefaultSource=1
Name=TDI,GlitchEnable_Present=true,DefaultSource=1
Name=TDO,GlitchEnable_Present=true,DefaultSource=1
Name=TMS,GlitchEnable_Present=true,DefaultSource=1

@SIGNAL_GROUPS
Name=ALL,Signals="TX0_PL,TX0_MN,RX0_PL,RX0_MN,REFCLK_PL,REFCLK_MN,12V_POWER,3V3_POWER,3V3_AUX,PERST,WAKE,CLKREQ,SMCLK,SMDAT,PWRBRK,PRESENT1,PRESENT2_B17,PRESENT2_B31,PRESENT2_B48,PRESENT2_B81,TRST,TCK,TDI,TDO,TMS"
