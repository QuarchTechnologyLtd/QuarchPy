Name=WAKE,GlitchEnable_Present=true,SignalDrive_Present=true,SignalMonitor_Present=true,DefaultSource=1
Name=CLKREQ,GlitchEnable_Present=true,SignalDrive_Present=true,SignalMonitor_Present=true,DefaultSource=1
Name=SMCLK,GlitchEnable_Present=true,SignalMonitor_Present=true,DefaultSource=1
Name=SMDAT,GlitchEnable_Present=true,SignalMonitor_Present=true,DefaultSource=1
Name=PWRBRK,GlitchEnable_Present=true,SignalDrive_Present=true,SignalMonitor_Present=true,DefaultSource=1
