@CONFIG Version=1

@HEADER
DeviceClass=TorridonModule
DeviceNumbers=QTL3148-xx
DeviceNumbersExclude=
MinFirmwareRequired=5.000
MinFpgaRequired=1.1
DeviceDescription=GEN6 PCIe x16-1 Breaker-B + Triggering

#Describes general module abilities
@GENERAL
HotPlugRead_Present = true
GlitchStateRead_Present = true
SourceUserBounce_Present = true
Triggering_Present=true
PowerInjection_Present=true
SignalDrive_Present=true
HostPowerTriggering_Present=3V3_AUX,12V_HOST,3V3_HOST
HighResTiming_Present=true
BounceV2_Present=true
SignalMonitor_Present=true

#Describes all signals on the module
@SIGNALS
