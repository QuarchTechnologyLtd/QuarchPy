@CONFIG Version=1

# PCIe EDSFF Card Module
@HEADER
DeviceClass=TorridonModule
DeviceNumbers=QTL3141-xx
DeviceNumbersExclude=
MinFirmwareRequired=5.000
MinFpgaRequired=1.1
DeviceDescription=GEN6 EDSFF x8-1 Breaker

#Describes general module abilities
@GENERAL
HotPlugRead_Present = true
GlitchStateRead_Present = true
SourceUserBounce_Present = true
HighResTiming_Present=true
BounceV2_Present=true
SignalDrive_Present=true
SignalMonitor_Present=true
Triggering_Present=false
HostPowerTriggering_Present=3V3_AUX_HOST,12V_HOST
# PCIe signals are not in order, this flag warns the CLI test that it needs to be more clever about testing them
OutOfOrderSignalsInLanes_Present=true

#Describes all signals on this module
@SIGNALS
Name=PERST0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=REFCLKP0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=REFCLKN0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false

Name=REFCLKP1,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=REFCLKN1,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=PERST1,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true

Name=12V,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=3V3_AUX,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false

Name=PRSNT0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=PRSNT1,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=LED,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=SMBRST,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=SMBCLK,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=true
Name=SMBDAT,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=true
Name=PWRDIS,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true
Name=MFG,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=true
Name=DUALPORTEN,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=true,SignalMonitor_Present=true

Name=PETP0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=PETN0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=PERP0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false
Name=PERN0,GlitchEnable_Present=true,DefaultSource=1,SignalDrive_Present=false,SignalMonitor_Present=false



@SIGNAL_GROUPS
Name=ALL,Signals="PERST0,REFCLKP0,REFCLKN0,REFCLKP1,REFCLKN1,PERST1,12V,3V3_AUX,PRSNT0,PRSNT1,LED,SMBRST,SMBCLK,SMBDAT,PWRDIS,MFG,DUALPORTEN"
Name=LANE0,Signals="PETP0,PETN0,PERP0,PERN0"
Name=POWER,Signals="12V,3V3_AUX"
Name=SMB_BUS,Signals="SMBRST,SMBCLK,SMBDAT"
Name=CLK_A,Signals="REFCLKP0,REFCLKN0"
Name=CLK_B,Signals="REFCLKP1,REFCLKN1"
Name=MANAGEMENT,Signals="PRSNT0,PRSNT1,LED,SMBRST,SMBCLK,SMBDAT,PWRDIS,MFG,DUALPORTEN"
Name=PORT_A,Signals="REFCLKP0,REFCLKN0"
Name=PORT_B,Signals="REFCLKP1,REFCLKN1"



